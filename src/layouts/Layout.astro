---
import "../styles/global.css";
import { NAV, buildSearchIndex } from "../data";
import SearchBar from "../components/SearchBar";
import Sidebar from "../components/Sidebar";
import MobileNav from "../components/MobileNav";
import ThemeToggle from "../components/ThemeToggle";
import { url, stripBase } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  /** Hide the left chapter menu (e.g. on the home page). */
  wide?: boolean;
}

const { title, description = "Resumen de Netzwerk neu A1 por capítulos y temas para estudiar alemán.", wide = false } =
  Astro.props;
const searchIndex = buildSearchIndex();
const path = Astro.url.pathname;
const rel = stripBase(path);
const links = [
  { to: "/", label: "Kapitel" },
  { to: "/verben", label: "Verben" },
  { to: "/wortschatz", label: "Wortschatz" },
  { to: "/grammatik", label: "Grammatik" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <title>{title} · Netzwerk neu A1</title>
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches))
          document.documentElement.classList.add("dark");
      } catch {}
    </script>
  </head>
  <body class="min-h-screen font-sans">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-bg">
      Saltar al contenido
    </a>
    <header class="sticky top-0 z-30 border-b border-line bg-bg/90 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6">
        <MobileNav client:load nav={NAV} path={path} />
        <a href={url("/")} class="flex shrink-0 items-center gap-2">
          <span class="grid size-8 place-items-center rounded-lg bg-ink text-xs font-extrabold text-bg">A1</span>
          <span class="hidden text-sm leading-tight font-extrabold sm:block">Netzwerk neu<br /><span class="font-medium text-muted">Lernhilfe</span></span>
        </a>
        <nav class="ml-4 hidden items-center gap-1 lg:flex" aria-label="Secciones">
          {
            links.map((l) => (
              <a
                href={url(l.to)}
                class:list={[
                  "rounded-md px-3 py-1.5 text-sm font-semibold transition-colors hover:bg-surface-2",
                  (l.to === "/" ? rel === "/" || rel.startsWith("/kapitel") : rel.startsWith(l.to))
                    ? "text-ink"
                    : "text-muted",
                ]}
              >
                {l.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex min-w-0 flex-1 items-center justify-end gap-2 lg:flex-none">
          <SearchBar client:load items={searchIndex} variant="header" />
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <div class:list={["mx-auto max-w-7xl px-4 sm:px-6", !wide && "lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-10"]}>
      {
        !wide && (
          <aside class="hidden lg:block">
            <div class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto py-8 pr-2">
              <Sidebar client:load nav={NAV} path={path} />
            </div>
          </aside>
        )
      }
      <main id="main" class="min-w-0 py-8 sm:py-10">
        <slot />
      </main>
    </div>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-7xl px-4 py-8 text-sm text-muted sm:px-6">
        Material de estudio propio organizado según los temas de <em>Netzwerk neu A1</em> (Kursbuch y Übungsbuch).
        Este sitio no reproduce los textos ni ejercicios del libro; úsalo como complemento.
      </div>
    </footer>
  </body>
</html>
