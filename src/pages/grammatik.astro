---
import Layout from "../layouts/Layout.astro";
import { CHAPTERS, anchor, chapterHref } from "../data";
---

<Layout title="Grammatik" description="Resumen de la gramática de Netzwerk neu A1 por capítulos.">
  <header class="mb-10">
    <p class="text-sm font-extrabold tracking-wider text-muted uppercase">Übersicht</p>
    <h1 class="mt-1 text-4xl font-extrabold sm:text-5xl">Grammatik</h1>
    <p class="mt-2 max-w-prose text-lg text-muted">Todos los temas de gramática del nivel A1, en el orden en que aparecen.</p>
  </header>

  <ol class="space-y-10">
    {
      CHAPTERS.map((c) => (
        <li>
          <h2 class="text-xl font-extrabold">
            <a href={chapterHref(c)} class="hover:underline">
              <span class="text-muted tabular-nums">{c.number}.</span> {c.title}
            </a>
          </h2>
          <ul class="mt-3 grid gap-3 sm:grid-cols-2">
            {c.grammar.map((g) => (
              <li>
                <a
                  href={`${chapterHref(c)}#${anchor.grammar(g.id)}`}
                  class="block h-full rounded-2xl border border-line bg-surface p-5 transition-colors hover:border-ink/40"
                >
                  <span class="block text-lg font-extrabold">{g.title}</span>
                  <span class="block font-semibold text-muted">{g.titleEs}</span>
                  <span class="mt-2 line-clamp-2 block text-sm text-muted">{g.explanation[0].replace(/\*\*/g, "")}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Layout>
